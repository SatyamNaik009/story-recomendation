spring.application.name=story-stylist-backend
server.port=7070
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=110MB
# Drain a bounded rejected body so clients can receive the JSON 413 response.
server.tomcat.max-swallow-size=128MB

# Validation may be tightened independently of the servlet upload ceilings.
photo.validation.max-photos=10
photo.validation.max-file-size-bytes=10485760
photo.validation.max-prompt-length=300
photo.validation.max-pixels=25000000
photo.validation.max-width=10000
photo.validation.max-height=10000

story.photo.processing.max-width=1568
story.photo.processing.max-height=1568
story.photo.processing.jpeg-quality=0.85
story.photo.processing.output-format=jpeg
story.photo.processing.allow-upscaling=false
# Development preview only. Set false outside local development.
story.photo.processing.preview-enabled=true

# Local AI configuration. Only the selected provider needs a real API key; no fallback.
story.ai.provider=gemini
story.ai.gemini.api-key=YOUR_GEMINI_API_KEY
story.ai.gemini.model=gemini-3.6-flash
story.ai.openai.api-key=YOUR_OPENAI_API_KEY
story.ai.openai.model=gpt-6.1-terra
story.ai.timeout-seconds=90
story.ai.max-retries=1
story.ai.max-image-payload-bytes=12582912
story.ai.max-output-tokens=8192
